# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
triage-temp.ts

# données de travail transcription (volumineuses, non versionnées)
scripts/*.json
scripts/*.docx
scripts/giguet-revue.md

# Heptateuque : fac-similés (103 Mo), node_modules locaux, DOCX régénérables
scripts/heptateuque/img/
scripts/heptateuque/node_modules/
scripts/heptateuque/package-lock.json
scripts/heptateuque/*.docx

# sauvegardes et dry-runs de base (charte §1.4) — locaux, volumineux (106 Mo)
/audit/

# dossier de travail temporaire (OCR, PDF volumineux, artefacts)
/tmp/

# réglages Claude Code locaux (spécifiques à la machine)
.claude/settings.local.json
