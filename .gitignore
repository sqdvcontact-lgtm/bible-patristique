# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
triage-temp.ts

# données de travail transcription (volumineuses, non versionnées)
scripts/*.json
scripts/*.docx
scripts/giguet-revue.md

# Heptateuque : fac-similés (103 Mo), node_modules locaux, DOCX régénérables
scripts/heptateuque/img/
scripts/heptateuque/node_modules/
# Sous-projets de scripts (ex. segmentation-candidate) : leurs node_modules
# imbriqués n'étaient pas couverts par la règle ci-dessus et se sont retrouvés
# versionnés par erreur (7000+ fichiers). Le double astérisque les rattrape tous.
scripts/heptateuque/**/node_modules/
scripts/heptateuque/package-lock.json
scripts/heptateuque/*.docx

# sauvegardes et dry-runs de base (charte §1.4) — locaux, volumineux (106 Mo)
/audit/

# dossier de travail temporaire (OCR, PDF volumineux, artefacts)
/tmp/

# fac-similé source BnF 899 : 108 Mo, au-delà de la limite GitHub (100 Mo).
# Conservé localement, non versionné.
work/bible899/source/BnF_Fr_899.pdf

# Jeu d'import multimode Bible 899 (régénérable, environ 80 Mo hors archive).
/work/bible899/multimode/

# caches Python des scripts (régénérables)
__pycache__/
*.pyc

# réglages Claude Code locaux (spécifiques à la machine)
.claude/settings.local.json

# fac-similés Bible 899 : 1 488 images, 1,89 Go, servies depuis le seau Supabase
# `manuscrits` et non plus par le dépôt. Le dossier reste le MIROIR DE TRAVAIL local,
# où tournent les scripts d'atelier. Empreintes contrôlées par `npm run bible899:verifier`.
/public/manuscrits/bible-899/*.png
